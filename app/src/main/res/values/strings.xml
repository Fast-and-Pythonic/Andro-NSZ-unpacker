    <string name="settings_verification">Output verification</string>
    <string name="settings_verification_desc">Verify unpacked NCA hashes against the CNMT metadata. Nearly free; mismatches are reported as warnings, and the output is always kept.</string>
    <string name="settings_decompression_threads">Decompression workers</string>
    <string name="settings_threads_auto">Auto</string>
    <string name="settings_decompression_threads_desc">Experimental: how many files to unpack in parallel (available only while verification is off). Auto adapts to the core count. This speeds up a queue or folder of several files, not a single large file.</string>
    <string name="settings_smart_distribution">Smart core distribution</string>
    <string name="settings_smart_distribution_desc">On big.LITTLE phones, put the largest files on the fast cores and small ones on the slow cores (pinned via CPU affinity), instead of letting a heavy file stall on a slow core. Speeds up a queue or folder of several files; falls back to standard scheduling when the CPU is uniform or affinity is unavailable.</string>

    <!-- About screen -->
    <string name="action_about_app">About the app</string>
    <string name="about_app_title">About</string>

    <string name="about_links_title">Repositories</string>
    <string name="about_link_andro_nsz">Andro-NSZ (Android port)</string>
    <string name="about_link_nsz">nicoboss/nsz (original utility)</string>

    <string name="about_what_is_title">What is this app?</string>
    <string name="about_what_is_content">Andro-NSZ is an Android app for unpacking compressed files of special formats. It converts them using a native C engine for high performance.</string>

    <string name="about_formats_title">Supported formats</string>
    <string name="about_formats_content">The app unpacks compressed files into standard formats:</string>

    <string name="about_nsz_description">Compressed NSZ packages → standard NSP packages</string>
    <string name="about_xcz_description">Compressed XCZ images → standard XCI images</string>

    <string name="about_how_works_title">How it works</string>
    <string name="about_how_works_content">The app uses the Zstandard algorithm to decompress compressed NCZ files inside NSZ/XCZ containers. After decompression, files are re-encrypted with AES-CTR and saved in standard NSP/XCI format.\n\nYou can convert individual files or entire folders, preserving the directory structure.</string>

    <string name="about_requirements_title">Requirements</string>
    <string name="about_requirements_content">A prod.keys file containing cryptographic keys is required for proper operation. It is used to verify correct unpacking. You can install it via the app menu.</string>

    <string name="about_credits_title">Credits</string>
    <string name="about_credits_content">Based on the original nsz utility by nicoboss.</string>
    <string name="about_contributors_title">Contributors</string>
    <string name="about_contributors_content">manx98</string>

