    <string name="about_what_is_title">What is this app?</string>
    <string name="about_what_is_content">Andro-NSZ is an Android app for unpacking compressed files of special formats. It converts them using a native C engine for high performance.</string>

    <string name="about_formats_title">Supported formats</string>
    <string name="about_formats_content">The app unpacks compressed files into standard formats:</string>

    <string name="about_nsz_description">Compressed NSZ packages → standard NSP packages</string>
    <string name="about_xcz_description">Compressed XCZ images → standard XCI images</string>

    <string name="about_how_works_title">How it works</string>
    <string name="about_how_works_content">The app uses the Zstandard algorithm to decompress compressed NCZ files inside NSZ/XCZ containers. After decompression, files are re-encrypted with AES-CTR and saved in standard NSP/XCI format.\n\nYou can convert individual files or entire folders, preserving the directory structure.</string>

    <string name="about_requirements_title">Requirements</string>
    <string name="about_requirements_content">A prod.keys file containing cryptographic keys is required for proper operation. It is used to verify correct unpacking. You can install it via the app menu.</string>

    <string name="about_credits_title">Credits</string>
    <string name="about_credits_content">Based on the original nsz utility by nicoboss.</string>
